# Copy to bot/.env and fill in the values:  cp bot/.env.example bot/.env
# bot/.env is git-ignored. Never commit real keys.

# --- Gemini --------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Any Gemini model that supports structured output.
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high for Gemini 3.x. Leave empty for gemini-2.5-* models.
GEMINI_THINKING_LEVEL=low

# --- MediaWiki -----------------------------------------------------------------
WIKI_API_URL=http://localhost:8080/api.php
# Created at http://localhost:8080/index.php/Special:BotPasswords
# Username format is "<YourWikiUser>@<BotName>".
WIKI_BOT_USER=Admin@autoupdater
WIKI_BOT_PASSWORD=paste-the-generated-bot-password-here
